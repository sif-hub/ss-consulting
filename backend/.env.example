APP_NAME=SS Consulting API
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=production

# PostgreSQL — sur Render, coller directement la "Internal Database URL"
# fournie par votre instance PostgreSQL (menu Connect). Le préfixe
# postgresql:// fonctionne tel quel (psycopg2 est le driver par défaut).
DATABASE_URL=postgresql://user:password@host:5432/dbname

SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Domaine(s) exact(s) du frontend déployé (Netlify/Vercel), séparés par une
# virgule. Ne PAS laisser "*" en production.
BACKEND_CORS_ORIGINS=https://votre-site.netlify.app

PAYMENT_COMMISSION_RATE=2.0
PAYMENT_COMMISSION_ACCOUNT=657288777

# Fapshi — clés LIVE une fois le compte business.fapshi.com validé
FAPSHI_API_USER=
FAPSHI_API_KEY=
FAPSHI_BASE_URL=https://api.fapshi.com
# Secret configuré sur le tableau de bord Fapshi pour signer les webhooks
FAPSHI_WEBHOOK_SECRET=
# URL vers laquelle Fapshi redirige le client après paiement (optionnel)
FAPSHI_REDIRECT_URL=

# Intelligence artificielle (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
