APP_NAME=SS Consulting API
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=production

# PostgreSQL — sur Render, coller directement la "Internal Database URL"
# fournie par votre instance PostgreSQL (menu Connect). Le préfixe
# postgresql:// fonctionne tel quel (psycopg2 est le driver par défaut).
DATABASE_URL=postgresql://user:password@host:5432/dbname

SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Domaine(s) exact(s) du frontend déployé (Netlify/Vercel), séparés par une
# virgule. Ne PAS laisser "*" en production.
BACKEND_CORS_ORIGINS=https://votre-site.netlify.app

PAYMENT_COMMISSION_RATE=2.0
PAYMENT_COMMISSION_ACCOUNT=657288777

# Notch Pay — clés LIVE (pk_live./sk_live./hsk_live.), pas les clés test
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_PRIVATE_KEY=
NOTCHPAY_HASH_KEY=
NOTCHPAY_BASE_URL=https://api.notchpay.co
# URL publique HTTPS de CE backend (Render), suivie de la route webhook
NOTCHPAY_CALLBACK_URL=https://votre-backend.onrender.com/api/v1/paiements/notchpay/webhook

# Intelligence artificielle (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
